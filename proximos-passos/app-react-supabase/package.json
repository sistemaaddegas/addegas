{
  "name": "addegas-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "stripe:sync": "node scripts/stripe-sync.mjs",
    "db:massa": "docker exec -i supabase_db_addegas psql -U postgres -v ON_ERROR_STOP=1 -q < supabase/seeds/massa-10-adegas.sql",
    "db:test": "supabase db reset --no-seed && supabase test db",
    "db:lint": "supabase db lint --level warning --fail-on error",
    "db:types": "supabase gen types typescript --local > src/types/database.ts",
    "functions:serve": "supabase functions serve",
    "icons": "node scripts/generate-icons.mjs",
    "check:erros": "node scripts/check-erros.mjs"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "5.2.6",
    "@supabase/supabase-js": "^2.50.0",
    "@tanstack/react-query": "^5.80.0",
    "qrcode-generator": "1.4.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router": "^7.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vercel/config": "0.14.0",
    "@vitejs/plugin-react": "^4.5.0",
    "sharp": "0.34.4",
    "supabase": "2.122.0",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.0",
    "vite-plugin-pwa": "^1.0.0"
  },
  "engines": {
    "node": ">=20.19"
  }
}
