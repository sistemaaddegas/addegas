# Variáveis das Edge Functions. Local: copie para supabase/functions/.env (fica fora do git).
# Na nuvem: `supabase secrets set --env-file ...` por projeto (addegas-dev, addegas-prd), ver planejamento/dominio-e-email.md.
APP_ENV=local
APP_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174
APP_VERSION=dev
# Só local: endereço público do Supabase para URLs assinadas (o interno é http://kong:8000)
PUBLIC_API_URL=http://127.0.0.1:57321
MIN_APP_VERSION=0.0.0
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,https://app.addegas.com.br,https://admin.addegas.com.br,https://www.addegas.com.br

# Rotinas (pg_cron → pg_net → /functions/v1/cron/*)
CRON_SECRET=troque-por-um-valor-aleatorio

# E-mail (Resend, D56) · com EMAIL_ENABLED=false nada é enviado, só registrado no log
EMAIL_ENABLED=false
EMAIL_FROM=Addegas <naoresponda@addegas.com.br>
EMAIL_REPLY_TO_BILLING=financeiro@addegas.com.br
RESEND_API_KEY=

# WhatsApp (W-API, D32) · URL e token da instância
WHATSAPP_ENABLED=false
WAPI_SEND_URL=
WAPI_TOKEN=
WAPI_WEBHOOK_TOKEN=troque-por-um-valor-aleatorio

# Stripe (D01) · chaves de teste no dev
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_EXTRA_STORE_PRICE_IDS=
STRIPE_PORTAL_CONFIGURATION_ID=

# Captcha (Cloudflare Turnstile)
TURNSTILE_SECRET=
